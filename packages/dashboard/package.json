{
  "name": "@botss/dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "screenshots": "vite build && playwright test --project=screenshots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-virtual": "^3.13.0",
    "diff": "^8.0.2",
    "diff2html": "^3.4.52",
    "mermaid": "^11.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@botss/core": "workspace:*",
    "@botss/server": "workspace:*",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
