# .env.example
# Copy to .env for local development: cp .env.example .env
# Every variable the app reads is listed here. Local defaults work as-is with docker compose
# for a human running the main checkout. Never put real secrets in this file.
#
# Precedence: real environment variables always win over .env. For agent runs the Botss
# orchestrator exports per-agent values for COMPOSE_PROJECT_NAME (botss-<agent>), DB_PORT,
# BACKEND_PORT, FRONTEND_PORT, DATABASE_URL and TEST_DATABASE_URL, so parallel agents never
# share containers, volumes, or ports. Do not hardcode a project name here.

# ---- Local ports (defaults for the main checkout) ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432

# ---- Database ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Async SQLAlchemy URL for the backend and Alembic when run on the host
# (inside compose the services use host "db"; compose sets that itself)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Separate database for tests so they never wipe dev data. Required by the test suite.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test

# ---- Backend ----
# local | test | ci | production
#   test: registers seed and fault-injection routes for e2e; never use outside tests
#   production: the only value that marks the session cookie Secure
ENVIRONMENT=local
SESSION_COOKIE_NAME=botss_session
# Only for setups where the browser calls the API cross-origin. The default setup proxies
# /api through the Next.js origin and needs no CORS. JSON list only, for example:
# CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=[]
LOG_LEVEL=info

# ---- Frontend ----
# Server-only. Target of the next.config rewrite /api/:path* (resolved at build time) and the
# base URL Server Components use to call the backend (read at runtime).
# The browser never calls the backend directly; it uses relative /api paths.
API_INTERNAL_URL=http://localhost:8000
# Never put secrets in NEXT_PUBLIC_ variables: they are inlined into the browser bundle.

# ---- Third-party services (add only when the architecture uses them) ----
# STRIPE_SECRET_KEY=
# SMTP_URL=
